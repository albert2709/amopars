{
  "manifest_version": 3,
  "name": "XPath Lead Logger",
  "version": "1.0.0",
  "description": "Collects XPath values with 11 digits and appends them to a text log with date/time.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "XPath Logger"
  },
  "background": {
    "service_worker": "background.js"
  }
}
