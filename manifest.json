{
  "manifest_version": 3,
  "name": "amoPars Caller & SMS",
  "version": "1.0.0",
  "description": "Получает телефон с текущей страницы по XPath и запускает звонок или SMS через внешние API.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://www.moizvonki.ru/*",
    "https://*.moizvonki.ru/*",
    "https://wappi.pro/*",
    "https://*.wappi.pro/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "amoPars Caller & SMS"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
